{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "cd /app && MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 gunicorn app:app --bind 0.0.0.0:$PORT --workers 1 --timeout 1000",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "environmentVariables": {
      "PYTHONPATH": "/app"
    }
  }
}
